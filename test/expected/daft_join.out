-- Freeze a three-layer mixed-engine boundary. AVG remains in PG and float8
-- equality keeps the Join out of Daft admission.  The semantic subquery LIMIT
-- prevents the outer cross-input Filter from being folded into the Join, so
-- the admitted Daft Limit can sit between the PG Aggregate/Filter parents and
-- the PG Limit/HashJoin child tree.
SET pg_orca.daft_prefer_plan = on;
EXPLAIN (COSTS OFF)
SELECT avg(lid)
FROM (
    SELECT l.lid, r.rid
    FROM daft_join_l l JOIN daft_join_r r
      ON l.k::float8 = r.k::float8
    LIMIT 50000
) AS limited_join
WHERE lid > rid;
INFO:  pg_orca daft_trace selected=daft reason=PGDAFT_CBO_DAFT_WINNER daft_prefer_plan=on daft_plan_cost_multiplier=0.100000 selected_plan_total_cost=390187.249270 pg_to_arrow_calls=5 pg_to_arrow_min=4.884000 arrow_to_pg_calls=2 arrow_to_pg_min=54.884000 project_calls=0 project_min=0.000000 limit_calls=10 limit_min=3.000000
                                        QUERY PLAN                                        
------------------------------------------------------------------------------------------
 Aggregate
   ->  Result
         Filter: ((NULL::integer) > (NULL::integer))
         ->  Custom Scan (DaftExec)
               Daft Fragment: 1
               Daft Operators: Limit
               PG Sources: 1
               Daft IR Version: 1.0
               Estimated Input Rows: 50000
               Offload Decision: accepted
               ->  Limit
                     ->  Hash Join
                           Hash Cond: ((l.k)::double precision = (r.k)::double precision)
                           ->  Seq Scan on daft_join_l l
                           ->  Hash
                                 ->  Seq Scan on daft_join_r r
 Optimizer: pg_orca
(17 rows)

